            </column>
            <column caption='CY Avg Sales per Customer' datatype='real' name='[Calculation_1490972981958336519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    SUM(IF [Calculation_1147854970905260044] = [Calculation_1147854970916831249] THEN [Sales] END)&#13;&#10;    / [Calculation_1490972981596254208], 0)' />
            </column>
            <column caption='PY Avg Sales per Customer' datatype='real' name='[Calculation_1490972981958443016]' role='measure' type='quantitative'>
