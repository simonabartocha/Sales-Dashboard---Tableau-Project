            <column caption='CY Customers' datatype='integer' datatype-customized='true' name='[Calculation_1490972981596254208]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF YEAR([Order Date]) = [Calculation_1147854970916831249]&#13;&#10;    THEN [Customer ID]&#13;&#10;    END&#13;&#10;)' />
