              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_1147854970917040146]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='CY Profit' datatype='real' name='[Calculation_1147854971113685012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='PY Profit' datatype='real' name='[Calculation_1147854971113816085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]-1 THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='{SUM([CY Profit])}' datatype='real' name='[Calculation_1147854971114254359]' role='measure' type='quantitative' user:unnamed='Sheet 3'>
              <calculation class='tableau' formula='{SUM([Calculation_1147854971113685012])}' />
            </column>
            <column caption='%Diff Profit' datatype='real' default-format='p0.0%' name='[Calculation_1147854971114455064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1147854971113685012]) - SUM([Calculation_1147854971113816085]))/SUM([Calculation_1147854971113816085])' />
            </column>
            <column caption='Min/Max Profit' datatype='real' name='[Calculation_1147854971115585562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_1147854971113685012]) = WINDOW_MAX(SUM([Calculation_1147854971113685012]))&#13;&#10;THEN SUM([Calculation_1147854971113685012])&#13;&#10;ELSEIF SUM([Calculation_1147854971113685012]) = WINDOW_MIN(SUM([Calculation_1147854971113685012]))&#13;&#10;THEN SUM([Calculation_1147854971113685012])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='{[%Diff Profit]}' datatype='real' name='[Calculation_1147854971127570465]' role='measure' type='quantitative' user:unnamed='Profit dasboard'>
              <calculation class='tableau' formula='{[Calculation_1147854971114455064]}' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Month' name='[mn:Order Date:qk]' pivot='key' type='quantitative' />
