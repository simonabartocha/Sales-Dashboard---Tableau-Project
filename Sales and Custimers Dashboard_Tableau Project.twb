    <worksheet name='New vs Returning Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#898989'>New Customers</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.19rw79u1ow10a016p7cqy1blbre3].[sum:Calculation_1320680623823925257:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>of total this year</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Data Source' name='federated.19rw79u1ow10a016p7cqy1blbre3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2022'>
              <calculation class='tableau' formula='2022' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19rw79u1ow10a016p7cqy1blbre3'>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1147854970916831249]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='First Order Date ' datatype='date' name='[Calculation_1320680623819726853]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Customer ID] : MIN([Order Date]) }' />
            </column>
            <column caption='New vs Returning' datatype='string' name='[Calculation_1320680623819968518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = YEAR([Calculation_1320680623819726853])&#13;&#10;THEN &quot;New&quot;&#13;&#10;ELSE &quot;Returning&quot;&#13;&#10;END' />
            </column>
            <column caption='CY New Customers' datatype='integer' name='[Calculation_1320680623823278087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF YEAR([Order Date]) = [Calculation_1147854970916831249] &#13;&#10;       AND [Calculation_1320680623819968518] = &quot;New&quot;&#13;&#10;    THEN [Customer ID]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% New Customers' datatype='real' name='[Calculation_1320680623823466504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1320680623823278087] / [Calculation_1490972981596254208]' />
            </column>
            <column caption='Total % New Customers Fixed' datatype='real' default-format='p0.00%' name='[Calculation_1320680623823925257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : [Calculation_1320680623823466504] }' />
            </column>
            <column caption='CY Customers' datatype='integer' datatype-customized='true' name='[Calculation_1490972981596254208]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF YEAR([Order Date]) = [Calculation_1147854970916831249]&#13;&#10;    THEN [Customer ID]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1320680623819968518]' derivation='None' name='[none:Calculation_1320680623819968518:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1490972981596254208]' derivation='User' name='[pcto:usr:Calculation_1490972981596254208:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column-instance column='[Calculation_1320680623823925257]' derivation='Sum' name='[sum:Calculation_1320680623823925257:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
