        <title>
          <formatted-text>
            <run fontcolor='#898989' fontname='Tableau Book'>Total Profit</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.19rw79u1ow10a016p7cqy1blbre3].[sum:Calculation_1147854971114254359:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'><![CDATA[<[federated.19rw79u1ow10a016p7cqy1blbre3].[sum:Calculation_1147854971127570465:qk]> ]]></run>
            <run fontcolor='#d4d4d4' fontname='Tableau Book' fontsize='12'>vs. PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Data Source' name='federated.19rw79u1ow10a016p7cqy1blbre3' />
